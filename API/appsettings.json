{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.EventLog" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true
        }
      },
      {
        "Name": "EventLog",
        "Args": {
          "source": "EnterpriseADPasswordManager.API",
          "manageEventSource": true
        }
      }
    ],
    "Properties": {
      "Application": "EnterpriseADPasswordManager.API"
    }
  },
  "ConnectionStrings": {
    "Default": "<SQL_SERVER_CONNECTION_STRING>"
  },
  "Security": {
    "PayloadEncryption": {
      "Algorithm": "AES-GCM",
      "KeyId": "<KEY_ID>",
      "SharedKeyBase64": "<AES_GCM_SHARED_KEY_BASE64_32BYTE>",
      "KeySource": "WindowsCredentialManager|Vault",
      "KeyName": "<KEY_NAME>"
    }
  },
  "Messaging": {
    "RabbitMq": {
      "Host": "<RABBITMQ_HOST>",
      "Port": 5671,
      "VirtualHost": "adpm-dev",
      "Username": "<RABBITMQ_USER>",
      "Password": "<RABBITMQ_PASSWORD>",
      "UseTls": true,
      "SslServerName": "<RABBITMQ_TLS_SERVER_NAME>",
      "RequestedHeartbeat": 30
    },
    "Consumer": {
      "PrefetchCount": 50,
      "ConcurrencyLimit": 50
    }
  },
  "Realtime": {
    "SignalR": {
      "HubPath": "/hubs/jobs",
      "EnableDetailedErrors": false,
      "MaximumReceiveMessageSizeKb": 64
    }
  },
  "Auth": {
    "Oidc": {
      "Authority": "<OIDC_ISSUER_URL>",
      "ClientId": "<CLIENT_ID>",
      "Audience": "<AUDIENCE_OR_EMPTY>",
      "GroupClaim": "<GROUP_CLAIM>",
      "AllowedGroups": [ "<ALLOWED_GROUP_ID_OR_NAME>" ],
      "RequireHttpsMetadata": true
    }
  },
  "AllowedHosts": "*"
}
