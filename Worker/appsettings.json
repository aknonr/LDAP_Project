{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.EventLog" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/worker-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true
        }
      },
      {
        "Name": "EventLog",
        "Args": {
          "source": "EnterpriseADPasswordManager.Worker",
          "manageEventSource": true
        }
      }
    ],
    "Properties": {
      "Application": "EnterpriseADPasswordManager.Worker"
    }
  },
  "ConnectionStrings": {
    "Default": "<SQL_SERVER_CONNECTION_STRING>"
  },
  "Security": {
    "PayloadEncryption": {
      "Algorithm": "AES-GCM",
      "KeyId": "<KEY_ID>",
      "SharedKeyBase64": "<AES_GCM_SHARED_KEY_BASE64_32BYTE>",
      "KeySource": "WindowsCredentialManager|Vault",
      "KeyName": "<KEY_NAME>"
    }
  },
  "Messaging": {
    "RabbitMq": {
      "Host": "<RABBITMQ_HOST>",
      "Port": 5671,
      "VirtualHost": "adpm-dev",
      "Username": "<RABBITMQ_USER>",
      "Password": "<RABBITMQ_PASSWORD>",
      "UseTls": true,
      "SslServerName": "<RABBITMQ_TLS_SERVER_NAME>",
      "RequestedHeartbeat": 30,
      "UseQuorumQueues": true,
      "QuorumReplicationFactor": 3
    },
    "Outbox": {
      "Enabled": true,
      "UseBusOutbox": true,
      "QueryDelaySeconds": 3
    },
    "Consumer": {
      "PrefetchCount": 50,
      "ConcurrencyLimit": 50,
      "RetryAttempts": 3,
      "RetryIntervalSeconds": 5,
      "KillSwitch": {
        "Enabled": true,
        "TrackingPeriodSeconds": 60,
        "ActivationThreshold": 20,
        "TripThreshold": 50,
        "RestartTimeoutSeconds": 60
      }
    }
  },
  "WorkerRoles": {
    "EnableDiscovery": true,
    "EnableUpdate": true,
    "EnableVerify": true,
    "EnableInventorySync": true
  },
  "Ldap": {
    "Host": "<LDAP_HOST>",
    "Port": 636,
    "UseSsl": true,
    "ValidateServerCertificate": true,
    "TimeoutSeconds": 10,
    "AuthType": "Negotiate"
  },
  "RemoteExecution": {
    "Enabled": true,
    "Transport": "WinRM.PowerShell",
    "ConnectTimeoutSeconds": 5,
    "OverallTimeoutSeconds": 60,
    "CircuitBreaker": {
      "Enabled": true,
      "TrackingPeriodSeconds": 60,
      "MinimumThroughput": 20,
      "FailureThreshold": 0.5,
      "BreakDurationSeconds": 60
    }
  },
  "Verification": {
    "EnablePostUpdateVerification": true
  },
  "ThApi": {
    "Enabled": true,
    "BaseUrl": "<TH_API_BASE_URL>",
    "InventoryEndpoint": "/inventory",
    "ApiKey": "<TH_API_KEY>",
    "ApiKeyHeaderName": "X-API-Key",
    "BearerToken": "",
    "TimeoutSeconds": 15,
    "DiffRule": "UpdatedDate",
    "SyncIntervalSeconds": 900,
    "InitialDelaySeconds": 10
  }
}
