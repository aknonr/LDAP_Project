{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    }
  },
  "Ldap": {
    "ValidateServerCertificate": false
  },
  "ThApi": {
    "SyncIntervalSeconds": 300,
    "InitialDelaySeconds": 5
  }
}
