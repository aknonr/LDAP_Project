{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    }
  },
  "Ldap": {
    "ValidateServerCertificate": false
  },
  "RemoteExecution": {
    "Enabled": false
  },
  "WorkerRoles": {
    "EnableDiscovery": true,
    "EnableUpdate": true,
    "EnableVerify": true,
    "EnableInventorySync": true
  },
  "ThApi": {
    "SyncIntervalSeconds": 300,
    "InitialDelaySeconds": 5
  }
}
