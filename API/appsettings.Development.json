{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    }
  },
  "Messaging": {
    "Outbox": {
      "Enabled": true,
      "UseBusOutbox": true,
      "QueryDelaySeconds": 3
    },
    "RabbitMq": {
      "UseQuorumQueues": true,
      "QuorumReplicationFactor": 1
    },
    "Consumer": {
      "PrefetchCount": 20,
      "ConcurrencyLimit": 20,
      "RetryAttempts": 3,
      "RetryIntervalSeconds": 5,
      "KillSwitch": {
        "Enabled": true,
        "TrackingPeriodSeconds": 60,
        "ActivationThreshold": 20,
        "TripThreshold": 50,
        "RestartTimeoutSeconds": 60
      }
    }
  },
  "Realtime": {
    "SignalR": {
      "EnableDetailedErrors": false,
      "MaximumReceiveMessageSizeKb": 64
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  }
}
