{
  "meta": {
    "documentType": "agent_prompt_packages",
    "projectName": "EnterpriseADPasswordManager",
    "version": "1.3.0",
    "language": "tr-TR",
    "executionMode": "sequential_with_dependencies",
    "targetStack": {
      "language": "C#",
      "frameworkNow": ".NET 8",
      "frameworkFuture": ".NET 10",
      "db": "SQL Server 2022",
      "architecture": "Onion Architecture + Worker Services + Event Driven",
      "mq": "RabbitMQ + MassTransit",
      "realtime": "SignalR"
    },
    "globalConstraints": [
      "Reset yok; sadece change (oldPassword+newPassword).",
      "Disaridan erisim yok; sadece ic ag + internal DNS.",
      "DB ve loglarda sifre yok; sadece memory.",
      "MQ mesajlarinda sifre plain olmaz; AES-GCM ile encrypt edilir.",
      "LDAP sadece LDAPS 636.",
      "UI ve API ayri deploy edilebilir.",
      "Event-driven zorunlu; DB polling yok.",
      "Concurrency kontrollu: PrefetchCount ve UseConcurrencyLimit configten."
    ],
    "outputConventions": {
      "artifactNaming": {
        "docs": "docs/<topic>.md",
        "diagrams": "docs/diagrams/<name>.(png|svg|mmd)",
        "code": "src/<layer>/<project>",
        "tests": "tests/<project>.Tests"
      },
      "definitionOfDone": [
        "Build passes",
        "Unit tests pass",
        "No secrets or passwords in logs",
        "Deliverables produced and linked in PR description"
      ]
    }
  },
  "decisions": {
    "auth": "OIDC login + group allowlist + DB role mapping",
    "rabbitmq": "internal TLS, vhost per environment",
    "workerRuntime": "Windows Service",
    "uiApiSeparation": "separate deploy, backend-first",
    "thApi": "enabled",
    "secretHandling": "MQ payload encrypted (AES-GCM) with shared key",
    "discoveryTransport": "WinRM/PowerShell (CIM/WMI), plugin based"
  },
  "packages": [
    {
      "id": "PKG-000",
      "title": "Infrastructure Prereqs (RabbitMQ + TLS + Accounts)",
      "dependsOn": [],
      "inputs": {
        "environments": ["dev", "test", "prod"],
        "rabbitmq": {
          "cluster": "single_or_ha",
          "tlsPort": 5671,
          "vhosts": ["adpm-dev", "adpm-test", "adpm-prod"],
          "queues": [
            "server.discovery.commands",
            "server.update.commands",
            "server.verify.commands",
            "server.result.events"
          ]
        },
        "serviceAccounts": ["adpm-api", "adpm-worker"]
      },
      "prompt": "Ic agda RabbitMQ kurulumu, TLS sertifika, vhost/permission ve firewall kurallarini dokumante et. Runbook ekle.",
      "expectedOutputs": [
        {
          "type": "markdown",
          "pathHints": ["docs/infra-prereqs.md"],
          "acceptance": "TLS, vhost, user/perm, firewall net tanimli."
        }
      ],
      "verificationSteps": [
        "TLS handshake testi",
        "API/Worker subnet erisim testi"
      ]
    },
    {
      "id": "PKG-001",
      "title": "Backend Solution Bootstrap (Onion Architecture)",
      "dependsOn": ["PKG-000"],
      "inputs": {
        "repoMode": "monorepo",
        "backendRepoName": "adpm-backend",
        "layers": ["Domain", "Application", "Infrastructure", "API", "Worker"],
        "framework": ".NET 8"
      },
      "prompt": "Onion Architecture backend solution kur. Katman bagimliliklarini dogru ayarla. Baseline test projesi ekle. README ve docs/architecture-overview.md yaz.",
      "expectedOutputs": [
        {
          "type": "code",
          "pathHints": ["src/Domain", "src/Application", "src/Infrastructure", "src/API", "src/Worker"],
          "acceptance": "Solution build olur, en az 1 test calisir."
        },
        {
          "type": "markdown",
          "pathHints": ["README.md", "docs/architecture-overview.md"],
          "acceptance": "Katmanlar ve bagimliliklar net."
        }
      ],
      "verificationSteps": ["dotnet restore", "dotnet build", "dotnet test"]
    },
    {
      "id": "PKG-002",
      "title": "Config & Secrets Strategy",
      "dependsOn": ["PKG-001"],
      "inputs": {
        "environments": ["dev", "test", "prod"],
        "secretsStoreOptions": ["Windows Credential Manager", "Vault (kurum standardi)"],
        "payloadProtection": "AES-GCM (shared key, keyId)",
        "loggingTargets": ["file", "eventlog", "siem-forward (opsiyon)"]
      },
      "prompt": "Ortam bazli config ve secrets yonetimi tanimla. AES-GCM payload encryption ve log redaction politikasini yaz. appsettings.* iskeleti ve Serilog konfig ekle.",
      "expectedOutputs": [
        {
          "type": "markdown",
          "pathHints": ["docs/config-and-secrets.md", "docs/logging-redaction-policy.md"],
          "acceptance": "Sifreler config/log/MQ'da plain degil."
        },
        {
          "type": "code",
          "pathHints": ["src/API/appsettings*.json", "src/Worker/appsettings*.json"],
          "acceptance": "Ortam ayrimi ve logging temel config mevcut."
        }
      ],
      "verificationSteps": [
        "Config dosyalarinda secret placeholder var mi?",
        "Loglarda sifre maskesi zorunlu mu?"
      ]
    },
    {
      "id": "PKG-003",
      "title": "SQL Server Schema + EF Core Models & Migrations",
      "dependsOn": ["PKG-001"],
      "inputs": {
        "entities": [
          "AppUser", "Role", "AppUserRole",
          "Job", "JobTarget", "JobResource",
          "ServerInventory", "ServerGroup",
          "AuditLog", "OutboxMessage"
        ],
        "enums": {
          "JobType": ["DISCOVERY", "PASSWORD_CHANGE", "VERIFY"],
          "JobStatus": ["PENDING", "IN_PROGRESS", "SUCCESS", "FAILED", "CANCELLED"],
          "TargetStatus": ["PENDING", "IN_PROGRESS", "SUCCESS", "FAILED", "SKIPPED"],
          "ResourceType": [
            "Service", "ScheduledTask", "IISAppPool",
            "IISSite", "IISWebApp", "IISVirtualDir",
            "COMPlus", "UserRight"
          ]
        }
      },
      "prompt": "Domain entity ve enumlari tanimla. Infrastructure DbContext + Fluent API yaz. Migrations uret. docs/data-model.md + mermaid ER ekle.",
      "expectedOutputs": [
        {
          "type": "code",
          "pathHints": ["src/Domain/Entities", "src/Infrastructure/Persistence", "src/Infrastructure/Migrations"],
          "acceptance": "Migrations ile DB kurulabiliyor."
        },
        {
          "type": "markdown",
          "pathHints": ["docs/data-model.md"],
          "acceptance": "ER diagram + tablo aciklamalari var."
        }
      ],
      "verificationSteps": ["dotnet ef migrations add InitialCreate", "dotnet ef database update"]
    },
    {
      "id": "PKG-004",
      "title": "OIDC Login + Group Allowlist + RBAC",
      "dependsOn": ["PKG-003", "PKG-002"],
      "inputs": {
        "oidc": {
          "issuer": "<OIDC_ISSUER_URL>",
          "clientId": "<CLIENT_ID>",
          "audience": "<AUDIENCE>",
          "groupClaim": "<GROUP_CLAIM>",
          "allowedGroups": ["<ALLOWED_GROUP_ID_OR_NAME>"]
        },
        "roles": ["Admin", "Operator", "Viewer"]
      },
      "prompt": "OIDC login akisini uygula. groupClaim icinde allowedGroups yoksa 403. AppUser/Role ile RBAC uygula. docs/auth-rbac.md ekle.",
      "expectedOutputs": [
        {
          "type": "code",
          "pathHints": ["src/API/Auth", "src/API/Program.cs", "src/Application/Services/Rbac"],
          "acceptance": "Login ve role-based authorization calisir."
        },
        {
          "type": "markdown",
          "pathHints": ["docs/auth-rbac.md"],
          "acceptance": "OIDC + grup kontrolu akisi net."
        }
      ],
      "verificationSteps": ["401/403 senaryolari"]
    },
    {
      "id": "PKG-005",
      "title": "TH API Inventory Sync",
      "dependsOn": ["PKG-003", "PKG-002"],
      "inputs": {
        "thApi": {
          "inventoryFields": ["id", "createdDate", "hostname", "ip", "groupId", "groupName"]
        },
        "syncMode": "scheduled_job",
        "diffRule": "createdDate or updatedDate"
      },
      "prompt": "TH API client yaz. ServerGroup ve ServerInventory tablolarini guncelle. docs/th-api-inventory.md olustur.",
      "expectedOutputs": [
        {
          "type": "code",
          "pathHints": ["src/Infrastructure/ThApi", "src/Worker/Jobs/InventorySyncJob.cs"],
          "acceptance": "Inventory sync calisiyor."
        },
        {
          "type": "markdown",
          "pathHints": ["docs/th-api-inventory.md"],
          "acceptance": "Akis ve hata senaryolari var."
        }
      ],
      "verificationSteps": ["Inventory sync ve diff testi"]
    },
    {
      "id": "PKG-006",
      "title": "AD Password Change Service (LDAPS 636)",
      "dependsOn": ["PKG-004", "PKG-002"],
      "inputs": {
        "library": "System.DirectoryServices.Protocols",
        "changeMode": "oldPassword+newPassword",
        "errorCodes": [
          "INVALID_CREDENTIALS", "POLICY_VIOLATION", "ACCESS_DENIED",
          "USER_NOT_FOUND", "LDAPS_CONNECT_FAILED", "TIMEOUT", "UNKNOWN"
        ]
      },
      "prompt": "LDAPS ile change password servisi yaz. TLS ve sertifika dogrulama configurable olsun. ErrorCode mapping yap.",
      "expectedOutputs": [
        {
          "type": "code",
          "pathHints": ["src/Infrastructure/Directory/AdPasswordChangeService.cs", "src/Application/Models/OperationResult.cs"],
          "acceptance": "ErrorCode standard donuyor."
        },
        {
          "type": "markdown",
          "pathHints": ["docs/ad-ldaps-change.md"],
          "acceptance": "Hata map tablosu var."
        }
      ],
      "verificationSteps": ["Success/invalid/policy testleri"]
    },
    {
      "id": "PKG-007",
      "title": "Resource Discovery Engine",
      "dependsOn": ["PKG-003"],
      "inputs": {
        "discoveryMethods": ["WinRM/PowerShell", "WMI/CIM"],
        "resourceTypes": [
          "Service", "ScheduledTask", "IISAppPool",
          "IISSite", "IISWebApp", "IISVirtualDir",
          "COMPlus", "UserRight"
        ],
        "defaultConcurrency": 10
      },
      "prompt": "Service account kullanimini sunucularda tarayan engine tasarla. Plugin tabanli olsun. Sonuclari JobResource ve JobTargeta yaz.",
      "expectedOutputs": [
        {
          "type": "code",
          "pathHints": ["src/Application/Interfaces/IDiscoveryStrategy.cs", "src/Infrastructure/Discovery/*"],
          "acceptance": "Discovery job 2000+ hedefte stabil."
        },
        {
          "type": "markdown",
          "pathHints": ["docs/discovery-engine.md"],
          "acceptance": "Kaynak tipleri ve hata kodlari net."
        }
      ],
      "verificationSteps": ["2000 hedef dry-run", "Concurrency ayari testi"]
    },
    {
      "id": "PKG-008",
      "title": "Update Engine (Apply New Password to Resources)",
      "dependsOn": ["PKG-007", "PKG-006"],
      "inputs": {
        "updateStrategies": [
          "Service", "ScheduledTask", "IISAppPool",
          "IISSite", "IISWebApp", "IISVirtualDir", "COMPlus"
        ],
        "errorCodes": [
          "RESOURCE_NOT_FOUND", "ACCESS_DENIED",
          "WINRM_CONNECT_FAILED", "TIMEOUT", "UNKNOWN"
        ],
        "idempotency": true
      },
      "prompt": "Her kaynak tipi icin update stratejisi yaz. New password sadece memoryde tutulacak. Idempotent olacak sekilde uygula.",
      "expectedOutputs": [
        {
          "type": "code",
          "pathHints": ["src/Application/Interfaces/IUpdateStrategy.cs", "src/Infrastructure/Update/*"],
          "acceptance": "Update job target bazinda status donuyor."
        },
        {
          "type": "markdown",
          "pathHints": ["docs/update-engine.md"],
          "acceptance": "Kaynak bazli update akisi net."
        }
      ],
      "verificationSteps": ["Basarili/basarisiz update senaryolari"]
    },
    {
      "id": "PKG-009",
      "title": "RabbitMQ Topology + Message Contracts",
      "dependsOn": ["PKG-002", "PKG-003"],
      "inputs": {
        "commands": [
          "DiscoverServerUsageCommand",
          "UpdateServerResourcesCommand",
          "VerifyServerCommand"
        ],
        "events": [
          "ServerUsageResultEvent",
          "ServerUpdateResultEvent",
          "JobProgressEvent"
        ],
        "payloadSchema": {
          "encryptedPassword": {
            "ciphertext": "base64",
            "nonce": "base64",
            "tag": "base64",
            "keyId": "string"
          }
        },
        "retryPolicy": { "attempts": 3, "intervalMs": 5000 }
      },
      "prompt": "MassTransit ile RabbitMQ topology kur. Command/event contractlarini yaz. AES-GCM encrypted payload kullan.",
      "expectedOutputs": [
        {
          "type": "code",
          "pathHints": ["src/Application/Messaging", "src/Infrastructure/Messaging"],
          "acceptance": "Publish/consume calisiyor."
        },
        {
          "type": "markdown",
          "pathHints": ["docs/messaging-topology.md"],
          "acceptance": "Exchange/queue/routing net."
        }
      ],
      "verificationSteps": ["Publish->Consume testi", "DLQ testi"]
    },
    {
      "id": "PKG-010",
      "title": "Worker Consumers + Concurrency + Retry",
      "dependsOn": ["PKG-009", "PKG-008"],
      "inputs": {
        "prefetchCount": 50,
        "concurrencyLimit": 50,
        "timeouts": { "connectSeconds": 5, "overallSeconds": 60 }
      },
      "prompt": "Worker consumerlari yaz. Prefetch ve concurrency limitlerini configten oku. Retry ve timeout uygula.",
      "expectedOutputs": [
        {
          "type": "code",
          "pathHints": ["src/Worker/Consumers", "src/Worker/Program.cs"],
          "acceptance": "Yuk artinca worker sayisi artirilabiliyor."
        }
      ],
      "verificationSteps": ["Load testi", "Timeout/retry davranisi"]
    },
    {
      "id": "PKG-011",
      "title": "API Endpoints (Auth + Job Create/Status)",
      "dependsOn": ["PKG-004", "PKG-009"],
      "inputs": {
        "endpoints": [
          "POST /auth/login",
          "POST /jobs/discovery",
          "POST /jobs/password-change",
          "GET /jobs/{id}",
          "GET /jobs/{id}/targets"
        ],
        "validationRules": [
          "passwords are never logged",
          "serverGroup required",
          "role: Operator/Admin can start jobs",
          "group allowlist enforced"
        ]
      },
      "prompt": "Job create ve izleme endpointlerini uygula. DB kaydi olustur, MQ komutlarini publish et. RBAC ve validation uygula.",
      "expectedOutputs": [
        {
          "type": "code",
          "pathHints": ["src/API/Controllers/JobsController.cs", "src/Application/UseCases/*"],
          "acceptance": "Job create ve status calisiyor."
        },
        {
          "type": "markdown",
          "pathHints": ["docs/api-contract.md"],
          "acceptance": "Request/response ornekleri var."
        }
      ],
      "verificationSteps": ["Operator 200, Viewer 403", "Target count dogru"]
    },
    {
      "id": "PKG-012",
      "title": "SignalR Live Updates",
      "dependsOn": ["PKG-011", "PKG-010"],
      "inputs": {
        "hubPath": "/hubs/jobs",
        "events": ["jobUpdated", "targetUpdated"],
        "clientScale": { "targets": 2000, "recommendations": ["paging", "virtualization"] }
      },
      "prompt": "SignalR hub ekle. Worker sonucu eventleri API uzerinden SignalR ile publish et.",
      "expectedOutputs": [
        {
          "type": "code",
          "pathHints": ["src/API/Hubs/JobsHub.cs", "src/API/Consumers/ResultEventConsumer.cs"],
          "acceptance": "UI canli guncelleme goruyor."
        },
        {
          "type": "markdown",
          "pathHints": ["docs/realtime-updates.md"],
          "acceptance": "Performans notlari var."
        }
      ],
      "verificationSteps": ["TargetUpdated event akisi"]
    },
    {
      "id": "PKG-013",
      "title": "Observability + Audit Trail + Security Checklist",
      "dependsOn": ["PKG-002", "PKG-010", "PKG-011"],
      "inputs": {
        "logging": ["Serilog.AspNetCore", "Serilog.Sinks.File", "Serilog.Sinks.EventLog"],
        "auditFields": ["who", "when", "ticketRef", "targetAccount", "serverGroup", "resultSummary"],
        "redaction": ["oldPassword", "newPassword", "tokens", "secrets"]
      },
      "prompt": "Structured logging, correlationId ve audit trail standartlarini kur. Redaction zorunlu. docs/audit-and-logging.md + docs/security-checklist.md ekle.",
      "expectedOutputs": [
        {
          "type": "code",
          "pathHints": ["src/API/Logging", "src/Worker/Logging"],
          "acceptance": "Sifre loglanmiyor; correlationId ile izlenebilir."
        },
        {
          "type": "markdown",
          "pathHints": ["docs/audit-and-logging.md", "docs/security-checklist.md"],
          "acceptance": "Audit alanlari ve checklist net."
        }
      ],
      "verificationSteps": ["Loglarda sifre yok", "Audit sorgulari calisiyor"]
    },
    {
      "id": "PKG-014",
      "title": "UI (Phase 2)",
      "dependsOn": ["PKG-011", "PKG-012"],
      "inputs": {
        "uiStack": "TBD (React or Blazor)",
        "pages": ["Dashboard", "Discovery", "Password Change Form", "Job Detail", "Unauthorized"],
        "splitTabs": ["Basarili", "Basarisiz"],
        "columns": ["Server", "Status", "ResourceType", "ErrorCode", "ErrorMessage", "UpdatedAt"]
      },
      "prompt": "UI ekranlarini uygula. 2000+ hedef icin paging/virtualization ekle. Role bazli UI guard kur.",
      "expectedOutputs": [
        {
          "type": "code",
          "pathHints": ["src/UI"],
          "acceptance": "Basarili/basarisiz ayrimi ve detay gorunuyor."
        },
        {
          "type": "markdown",
          "pathHints": ["docs/ui-flow.md"],
          "acceptance": "Kullanici akisi net."
        }
      ],
      "verificationSteps": ["Job create -> detail auto open", "Viewer teknik detay gorememeli"]
    }
  ],
  "executionOrder": [
    "PKG-000",
