{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    }
  },
  "Ldap": {
    "ValidateServerCertificate": false
  },
  "RemoteExecution": {
    "Enabled": false
  },
  "Verification": {
    "EnablePostUpdateVerification": true
  },
  "Messaging": {
    "Outbox": {
      "Enabled": true,
      "UseBusOutbox": true,
      "QueryDelaySeconds": 3
    },
    "RabbitMq": {
      "UseQuorumQueues": true,
      "QuorumReplicationFactor": 1
    }
  },
  "WorkerRoles": {
    "EnableDiscovery": true,
    "EnableUpdate": true,
    "EnableVerify": true,
    "EnableInventorySync": true
  },
  "ThApi": {
    "SyncIntervalSeconds": 300,
    "InitialDelaySeconds": 5
  }
}
